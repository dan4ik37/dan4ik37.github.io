{
  "functions": {
    "api/vip-sync.js": {
      "maxDuration": 30
    },
    "api/push-check.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/vip-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/push-check",
      "schedule": "0 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v/:id",
      "destination": "/api/video?id=:id"
    },
    {
      "source": "/history",
      "destination": "/api/history"
    },
    {
      "source": "/tools/nick",
      "destination": "/api/tool-nick"
    },
    {
      "source": "/topics",
      "destination": "/api/topic"
    },
    {
      "source": "/topic/:slug",
      "destination": "/api/topic?slug=:slug"
    },
    {
      "source": "/videos",
      "destination": "/api/videos"
    },
    {
      "source": "/games",
      "destination": "/api/game"
    },
    {
      "source": "/games/:id",
      "destination": "/api/game?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ]
}
