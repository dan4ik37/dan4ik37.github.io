// T-163 «Творческий режим» (owner 13.11: «полёт над планетами можно вообще оставить как творческий режим просто, для отдельного
// мира»): the same home planet as scenes/planet.ron (seed 37), free flight from orbit, no game layer (no survival). The
// site keeps its save in its own slot (world «creative»), never the main world's; the main world is scenes/valley.ron.
// The player starts in orbit with the whole planet in view, flies down, lands and walks; one button flies back up.
// `terrain`, `sun` and `cameras` belong to flat scenes and are not used by a planet scene (the sun is the planet's).
(
    version: 0,
    name: "creative",
    seed: 37,
    terrain: (radius: 1),
    sun: (azimuth_deg: 0, elevation_deg: 45),
    cameras: {},
    planet: (
        profile: "home",
        // a green coast under the morning sun
        at: (29.0, 81.0),
        altitude: 175000,
        yaw_deg: 0,
        pitch_deg: -75,
        time: 1930,
        views: {
            "orbit_day": (lat: 29, lon: 81, altitude: 175000, pitch_deg: -90, time: 1930),
            "orbit_terminator": (lat: 29, lon: 81, altitude: 175000, pitch_deg: -90, time: 2500),
            "high_20km": (lat: 29, lon: 81, altitude: 20000, yaw_deg: 30, pitch_deg: -35, time: 1930),
            "low_1km": (lat: 29, lon: 81, altitude: 1000, yaw_deg: 30, pitch_deg: -18, time: 1930),
            "ground_noon": (lat: 29, lon: 81, altitude: 1.7, yaw_deg: 30, pitch_deg: 2, time: 1860, fov_y_deg: 70),
            "ground_sunset": (lat: 29, lon: 81, altitude: 1.7, yaw_deg: 250, pitch_deg: 6, time: 2356, fov_y_deg: 70),
            // EP2: the western shore of the same coast (water: waves, depth colour, foam, the sky in it)
            "shore_water": (lat: 29, lon: 80.03, altitude: 2.5, yaw_deg: 75, pitch_deg: -7, time: 1930, fov_y_deg: 70),
        },
    ),
)
