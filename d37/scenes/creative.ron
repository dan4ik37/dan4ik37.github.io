// T-163 «Творческий режим» (owner 13.11: «полёт над планетами можно вообще оставить как творческий режим просто, для отдельного
// мира»): the same home planet as scenes/planet.ron (seed 37), free flight from orbit. w11 creative (R-LATE-1113-10): the
// game layer with creative rules (`creative: true`, crates/d37-app/src/game/sys/creative): no hunger or damage, every
// block / part / item without materials, fast place / remove, time / weather / animals on call. The site keeps its save
// in its own slot (world «creative»), never the main world's; the main world is scenes/valley.ron (nothing from thin air).
// The player starts in orbit with the whole planet in view, flies down, lands and builds; one button flies back up.
// `terrain`, `sun` and `cameras` belong to flat scenes and are not used by a planet scene (the sun is the planet's).
(
    version: 0,
    name: "creative",
    seed: 37,
    terrain: (radius: 1),
    sun: (azimuth_deg: 0, elevation_deg: 45),
    cameras: {},
    planet: (
        profile: "home",
        // a green coast under the morning sun
        at: (29.0, 81.0),
        altitude: 175000,
        yaw_deg: 0,
        pitch_deg: -75,
        time: 1930,
        views: {
            "orbit_day": (lat: 29, lon: 81, altitude: 175000, pitch_deg: -90, time: 1930),
            "orbit_terminator": (lat: 29, lon: 81, altitude: 175000, pitch_deg: -90, time: 2500),
            "high_20km": (lat: 29, lon: 81, altitude: 20000, yaw_deg: 30, pitch_deg: -35, time: 1930),
            "low_1km": (lat: 29, lon: 81, altitude: 1000, yaw_deg: 30, pitch_deg: -18, time: 1930),
            "ground_noon": (lat: 29, lon: 81, altitude: 1.7, yaw_deg: 30, pitch_deg: 2, time: 1860, fov_y_deg: 70),
            "ground_sunset": (lat: 29, lon: 81, altitude: 1.7, yaw_deg: 250, pitch_deg: 6, time: 2356, fov_y_deg: 70),
            // EP2: the western shore of the same coast (water: waves, depth colour, foam, the sky in it)
            "shore_water": (lat: 29, lon: 80.03, altitude: 2.5, yaw_deg: 75, pitch_deg: -7, time: 1930, fov_y_deg: 70),
            // ep22 picture: the owner's taiga spot of 20.11 (his panel: МЕСТО 51976 86886 -42268), scenarios/look_taiga.ron
            "owner_taiga": (lat: 52.366, lon: 39.119, altitude: 1.7, yaw_deg: 0, pitch_deg: -8, time: 1930, fov_y_deg: 70),
            // ep31 picture: the same spot from the air (scenarios/look_fill.ron: the far forest must read as forest)
            "taiga_300": (lat: 52.366, lon: 39.119, altitude: 300, yaw_deg: 200, pitch_deg: -28, time: 1930, fov_y_deg: 70),
            "taiga_1500": (lat: 52.366, lon: 39.119, altitude: 1500, yaw_deg: 200, pitch_deg: -22, time: 1930, fov_y_deg: 70),
            "taiga_6000": (lat: 52.366, lon: 39.119, altitude: 6000, yaw_deg: 200, pitch_deg: -25, time: 1930, fov_y_deg: 70),
            // lagfix (owner 27.11, build a57a17c78d: «ФПС показывает большой, а лагает сильно»): his swamp with a tribe and a herd
            // nearby (his panel: МЕСТО 31614 68378 -79763, БИОМ БОЛОТО) — scenarios/lag_swamp_*.ron, the browser gate's swamp rows
            "owner_swamp": (lat: 38.5531, lon: 68.3791, altitude: 1.7, yaw_deg: 0, pitch_deg: -4, time: 1930, fov_y_deg: 70),
        },
    ),
    // w11 creative: the game layer in creative mode (no guided start: the palette is in the pockets)
    game: (spawn: Home, hints: false, radius: 72, forest: 0.5, creative: true),
)
