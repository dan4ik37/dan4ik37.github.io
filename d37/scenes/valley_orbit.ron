// W8 spawn preset «orbit» of the valley world (the same seed, place and save as scenes/valley.ron): the player starts in
// the orbit flight above home (press the orbit button / `travel orbit` to fly; the landing is the home valley).
// EP7 — the first playable loop: the home planet (seed 37, the site's continents), the player wakes on the ground
// of a green coast with groves and clearings around (generated by the seed: no hand-made level), the sea a few hundred
// metres west for bridges. Chop trees, gather, craft, build a hut, light a fire; the world is saved by itself.
// Open on the web page with ?scene=./scenes/valley.ron (or `d37-client --scene scenes/valley.ron`).
(
    version: 0,
    name: "valley_orbit",
    seed: 37,
    terrain: (radius: 1),
    sun: (azimuth_deg: 0, elevation_deg: 45),
    cameras: {},
    planet: (
        profile: "home",
        at: (29.0, 80.36),
        altitude: 0,
        yaw_deg: 250,
        pitch_deg: -8,
        // a morning on the coast (the day is 40 minutes; `time 19:30` in the admin menu for the evening)
        time: 1890,
        views: {
            "valley_air": (lat: 29, lon: 80.36, altitude: 60, yaw_deg: 250, pitch_deg: -30, time: 1890, fov_y_deg: 70),
            "shore": (lat: 29, lon: 80.27, altitude: 1.7, yaw_deg: 262, pitch_deg: -5, time: 1890, fov_y_deg: 70),
        },
    ),
    // W8: spawn Home = the home valley (the place `home_valley`); Last = the last save; Orbit = the flight above home
    game: (spawn: Orbit, hints: false, radius: 72, forest: 0.5),
)
