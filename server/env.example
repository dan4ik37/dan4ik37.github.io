# What server/.env looks like (make-env.sh creates the real one ON THE SERVER with random secrets — never commit it).
RT_HOST=203.0.113.7
TURN_PUBLIC_IP=203.0.113.7
TURN_PRIVATE_IP=10.0.0.5
TURN_SECRET=<64 hex characters — openssl rand -hex 32>
ADMIN_TOKEN=<48 hex characters — openssl rand -hex 24>
# optional (defaults in server/rt/src/config.js):
# MAINTENANCE=1          — /health says ok:false, sockets are refused → the site uses Supabase (then: docker compose up -d)
# MAX_CONNS=4000         MAX_PER_IP=64        MAX_MSG=262144        LOG_LEVEL=info
# WATCH=1                — watch Supabase channels of our rooms (keep on: it prevents rooms split between two servers)
# AUDIT=file            — anti-cheat journal (off by default; docs/SERVER.md «Anti-cheat feed»): AUDIT_SALT, AUDIT_EVENTS, AUDIT_PER_SEC…
